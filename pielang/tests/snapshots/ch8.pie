#lang pie

(claim step-+
  (→ Nat Nat))
(define step-+
  (λ (+n-1)
    (add1 +n-1)))

(claim + (→ Nat Nat Nat))
(define +
  (λ (n j)
    (iter-Nat n
      j
      step-+)))

(claim incr
  (→ Nat Nat))
(define incr
  (λ (n)
    (iter-Nat n
      1
      (+ 1))))

(incr 0) ; (the Nat 1)

(= Nat (+ 1 1) 2) ; (the U (= Nat 2 2))

(Π ((n Nat))
  (= Nat (+ 1 n) (add1 n))) ; (the U (Π ((n Nat)) (= Nat (add1 n) (add1 n))))

(the (= Nat (+ 17 4) (+ 11 10)) (same 21)) ; (the (= Nat 21 21) (same 21))

(the (= Nat (+ 2 2) 4) (same (incr 3))) ; (the (= Nat 4 4) (same 4))

(claim +1=add1
  (Π ((n Nat))
    (= Nat (+ 1 n) (add1 n))))
(define +1=add1
  (λ (n)
    (same (add1 n))))

(claim incr=add1
  (Π ((n Nat))
    (= Nat (incr n) (add1 n))))

(claim base-incr=add1
  (= Nat (incr zero) (add1 zero)))
(define base-incr=add1
  (same (add1 zero)))

(claim mot-incr=add1
  (→ Nat U))
(define mot-incr=add1
  (λ (k)
    (= Nat (incr k) (add1 k))))

(claim step-incr=add1
  (Π ((n-1 Nat))
    (→ (= Nat
         (incr n-1)
         (add1 n-1))
      (= Nat
        (add1        
          (incr n-1))
        (add1
          (add1 n-1))))))
(define step-incr=add1
  (λ (n-1)
    (λ (incr=add1n-1)
      (cong incr=add1n-1 (+ 1)))))

(define incr=add1
  (λ (n)
    (ind-Nat n
      mot-incr=add1
      base-incr=add1
      step-incr=add1)))

(incr=add1 2) ; (the (= Nat 3 3) (same 3))