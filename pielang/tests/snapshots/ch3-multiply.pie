#lang pie

(claim step-+
  (→ Nat Nat))
(define step-+
  (λ (+n-1)
    (add1 +n-1)))

(claim + (→ Nat Nat Nat))
(define +
  (λ (n j)
    (iter-Nat n
      j
      step-+)))

(claim *
  (→ Nat Nat
    Nat))

(claim step-*
  (→ Nat Nat Nat
    Nat))
(define step-*
  (λ (j n-1 *_n-1)
    (+ j *_n-1)))

(define *
  (λ (n j)
    (rec-Nat n
      0
      (step-* j))))

