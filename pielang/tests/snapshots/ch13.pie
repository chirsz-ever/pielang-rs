(claim Odd
  (→ Nat U))
(define Odd
  (λ (n)
    (Σ ((haf Nat))
      (= Nat n (add1 (double haf))))))

; (claim one-is-odd
;   (Odd 1))
; (define one-is-odd
;   (cons 0
;     (same 1)))

