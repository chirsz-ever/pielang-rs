#lang pie

(claim + (→ Nat Nat Nat))
(define +
  (λ (n j)
    (iter-Nat n
      j
      (λ (k) (add1 k)))))

(claim double
  (→ Nat Nat))
(define double
  (λ (n)
    (iter-Nat n
      0
      (+ 2))))

(claim Even
  (→ Nat U))
(define Even
  (λ (n)
    (Σ ((half Nat))
      (= Nat n (double half)))))

(claim zero-is-even
  (Even 0))
(define zero-is-even
  (cons 0
    (same 0)))

; zero-is-even ; (cons 0 (same 0))

